name: test
on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test-matrix:
    runs-on: {{"${{"}} matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-go@v7
        with:
          go-version-file: go.mod
      - run: go test -race -shuffle=on -covermode=atomic -coverprofile=coverage.out ./...
        shell: bash
      # Publish the number rather than discard it. No token, no third party, no
      # account -- it lands on every run's summary page. The profile is computed
      # on all three OSes anyway; this consumes one of them.
      - if: matrix.os == 'ubuntu-latest'
        shell: bash
        run: |
          echo "### Coverage" >> "$GITHUB_STEP_SUMMARY"
          go tool cover -func=coverage.out | tail -1 >> "$GITHUB_STEP_SUMMARY"
{{ if .enable_codecov }}      - if: matrix.os == 'ubuntu-latest'
        uses: codecov/codecov-action@v7
        with:
          files: coverage.out
        env:
          CODECOV_TOKEN: {{"${{"}} secrets.CODECOV_TOKEN }}
{{ end }}
  # The required status check. The matrix above reports one context per OS
  # (`test-matrix (ubuntu-latest)` and so on), so a ruleset requiring a bare
  # `test` would wait on a producer that does not exist. This job is that
  # producer, and its name does not change when the matrix does.
  test:
    if: always()
    needs: [test-matrix]
    runs-on: ubuntu-latest
    steps:
      # always() means this job runs even when the matrix failed, so it must
      # fail explicitly. A skipped job reports a skipped check, which does not
      # block a merge -- success by not running, which is the shape of defect
      # this gate exists to prevent.
      - if: needs.test-matrix.result != 'success'
        run: exit 1

