# Desired state for this repository's settings on the remote host.
#
# Apply it with:   keel settings apply
# Check for drift: keel settings apply --check
#
# Only the keys named here are converged; anything omitted is left alone, so this
# file is safe to run against a repo you have also tuned by hand.
#
# The required_status_checks list below matches the workflows this recipe's
# modules emit. If you remove a discipline module, remove its check here too — a
# required check that never reports blocks every pull request.
version: 1

repository:
  allow_squash_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  allow_auto_merge: true
  delete_branch_on_merge: true
  has_wiki: false
  has_projects: false

security:
  dependency_graph: true
  dependabot_alerts: true
  dependabot_security_updates: true
  # Secret scanning is unavailable on private repos without GitHub Advanced
  # Security, so it is declared only when this repo is public.
  secret_scanning: {{ if eq .visibility "public" }}true{{ else }}false{{ end }}
  secret_scanning_push_protection: {{ if eq .visibility "public" }}true{{ else }}false{{ end }}
  private_vulnerability_reporting: true

actions:
  # local_and_verified plus the third-party actions this recipe's own modules
  # use. Both lists are computed from the modules present, so removing a module
  # removes its action and its check together.
  allowed: local_and_verified
  allowed_patterns:
{{- range .emitted_action_patterns }}
    - {{ . }}
{{- end }}
  default_workflow_permissions: read
  # Enabled because a module in this recipe asked for it -- release-plz cannot
  # open its release PR without it.
  can_approve_pull_request_reviews: {{ if index .emitted_needs "can_approve_pull_request_reviews" }}true{{ else }}false{{ end }}

rulesets:
  - name: "keel: main"
    target: branch
    ref: main
    required_status_checks:
{{- range .emitted_checks }}
      {{- /*
        coverage, audit and deny are declared by their modules but rendered by
        them only when their answer is on, so they are the checks a module can
        emit conditionally. Naming them here is the one restatement this file
        still makes; see the spec's open question on giving emits.checks its own
        gate.
      */}}
      {{- $gated := or
            (and (eq . "coverage") (not (index $ "enable_codecov")))
            (and (eq . "audit") (not (index $ "enable_cargo_audit")))
            (and (eq . "deny") (not (index $ "enable_cargo_deny"))) }}
      {{- if not $gated }}
      - {{ . }}
      {{- end }}
{{- end }}
    required_approving_reviews: 0
    required_linear_history: true
    block_force_push: true
    block_deletion: true
    bypass:
      - repo_admin
